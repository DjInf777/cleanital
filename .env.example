# Public runtime
PORT=4321
HOST=127.0.0.1
PUBLIC_SITE_URL=https://cleanital.com

# Durable intake storage. Must be outside the public repository and web root.
FORM_STORAGE_DIR=/var/lib/cleanital-website/submissions
FORM_RETENTION_DAYS=90

# Used to pseudonymize IP addresses in abuse records. Generate a long random value.
FORM_IP_HASH_KEY=replace-with-a-secret

# Optional notification webhook. Durable storage remains the intake system of record.
FORM_NOTIFICATION_WEBHOOK_URL=
FORM_NOTIFICATION_WEBHOOK_TOKEN=

# Allowed public origins, comma separated.
ALLOWED_ORIGINS=https://cleanital.com,https://www.cleanital.com

# Legal pages must remain blocked from production until externally approved.
LEGAL_COPY_APPROVED=false
