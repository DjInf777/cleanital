---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import InquiryForm from '../components/InquiryForm.astro';
---
<BaseLayout title="Contact" description="Contact Cleanital about general commercial, website, privacy, or accessibility questions."><PageHero eyebrow="General inquiries" title="Contact Cleanital" summary="Use the assessment path for a commercial service opportunity. Use this form for a general question, website issue, privacy request, or accessibility feedback." showCta={false}/><section class="section"><div class="container grid-2"><div class="prose"><h2>Commercial service request?</h2><p><a href="/request-an-assessment/">Request an Assessment</a> so Cleanital receives the facility and service details needed for qualification.</p><h2>Secure portal access?</h2><p>Portal links are published only after the specific Corp4ce destination is active and tested. No portal link is currently represented as active on this release candidate.</p></div><InquiryForm kind="contact"/></div></section></BaseLayout>
