---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import InquiryForm from '../components/InquiryForm.astro';
---
<BaseLayout title="Request an Assessment" description="Request Cleanital review of a commercial facility and cleaning need."><PageHero eyebrow="Primary commercial next step" title="Request an assessment" summary="Tell Cleanital about the commercial facility, service need, location, and schedule. The request begins review; it does not confirm service, pricing, scheduling, or acceptance." showCta={false}/><section class="section"><div class="container grid-2"><div class="prose"><h2>What this request does</h2><p>Cleanital uses the information to evaluate commercial fit, state-level territory fit, likely service need, and the appropriate follow-up.</p><h2>What it does not do</h2><ul><li>Create a client or contract</li><li>Confirm capacity or a start date</li><li>Bind pricing or authorize work</li><li>Create portal access</li></ul><p class="notice">Commercial facilities and organizations only. Service availability depends on facility location, scope, scheduling requirements, route density, and current operational capacity.</p></div><InquiryForm kind="assessment"/></div></section></BaseLayout>
