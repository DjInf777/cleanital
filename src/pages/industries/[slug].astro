---
import BaseLayout from '../../layouts/BaseLayout.astro';import PageHero from '../../components/PageHero.astro';import { industries, services } from '../../data/site';
export function getStaticPaths(){return industries.map(industry=>({params:{slug:industry.slug},props:{industry}}));}
const {industry}=Astro.props;const related=services.filter(s=>(industry.services as readonly string[]).includes(s.slug));
---
<BaseLayout title={industry.title} description={industry.summary} path={`/industries/${industry.slug}/`}><PageHero eyebrow="Industry context" title={industry.title} summary={industry.summary}/><section class="section"><div class="container narrow content-stack">{industry.sections.map(section=><section class="content-block"><h2>{section.title}</h2>{section.paragraphs?.map(p=><p>{p}</p>)}{section.bullets&&<ul>{section.bullets.map(item=><li>{item}</li>)}</ul>}</section>)}</div></section><section class="section section-alt"><div class="container"><div class="section-heading"><p class="eyebrow">Relevant services</p><h2>Services that may support this facility type.</h2></div><div class="grid-3">{related.map(s=><article class="card"><h3>{s.title}</h3><p>{s.summary}</p><a href={`/services/${s.slug}/`}>Review service scope →</a></article>)}</div></div></section><section class="cta-band"><div class="container"><h2>Discuss the facility, not just the industry label.</h2><a class="button" href="/request-an-assessment/">Request an Assessment</a></div></section></BaseLayout>
