---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, industries, site } from '../data/site';
---
<BaseLayout title="Cleanital" description={site.description}>
  <section class="hero"><div class="container hero-grid"><div><p class="eyebrow">Commercial facilities only</p><h1>Commercial cleaning built around the facility.</h1><p class="lede">Cleanital provides commercial janitorial, day porter, floor-care, post-construction, and project cleaning services for organizations in North Carolina and South Carolina.</p><div class="hero-actions"><a class="button button-light" href="/request-an-assessment/">Request an Assessment</a><a class="text-link" href="/services/">Explore Services <span aria-hidden="true">→</span></a></div></div><div class="hero-card"><strong>A clear first step</strong><p>Tell us about the facility, service need, and schedule. Cleanital will review the opportunity before making any commitment.</p><strong>State-level service area</strong><p>North Carolina and South Carolina. Actual availability depends on location, scope, route density, schedule, and current capacity.</p><strong>No instant promises</strong><p>A website request does not confirm pricing, availability, scheduling, or acceptance of work.</p></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><p class="eyebrow">Services</p><h2>Define the work before committing to it.</h2><p>Every service begins with the facility conditions, responsibilities, access, and outcome the organization actually needs.</p></div><div class="grid-3">{services.slice(0,6).map(service=><article class="card"><p class="pill">Commercial service</p><h3>{service.title}</h3><p>{service.summary}</p><a href={`/services/${service.slug}/`}>Learn about this service →</a></article>)}</div><p style="margin-top:1.5rem"><a class="button" href="/services/">View all services</a></p></div></section>
  <section class="section section-alt"><div class="container"><div class="section-heading"><p class="eyebrow">Industries</p><h2>Facility context changes the cleaning plan.</h2><p>Industry pages explain operating conditions and useful combinations of services—not duplicate service descriptions.</p></div><div class="grid-3">{industries.map(industry=><article class="card"><h3>{industry.title}</h3><p>{industry.summary}</p><a href={`/industries/${industry.slug}/`}>Explore facility needs →</a></article>)}</div></div></section>
  <section class="section dark-section"><div class="container grid-2"><div><p class="eyebrow">How we work</p><h2>Assessment before promise.</h2><p>Cleanital reviews fit, facility conditions, scope, schedule, access, and operational capacity before deciding whether to prepare a proposal.</p><a class="button button-light" href="/how-we-work/">See the process</a></div><div class="content-stack"><div class="card"><h3>1. Request</h3><p>Submit the commercial facility and service need.</p></div><div class="card"><h3>2. Assess</h3><p>Define conditions, responsibilities, and expectations.</p></div><div class="card"><h3>3. Decide</h3><p>Cleanital determines whether the work is an operational fit.</p></div></div></div></section>
  <section class="cta-band"><div class="container"><div><p class="eyebrow">Commercial opportunity</p><h2>Start with a facility assessment request.</h2></div><a class="button" href="/request-an-assessment/">Request an Assessment</a></div></section>
</BaseLayout>
