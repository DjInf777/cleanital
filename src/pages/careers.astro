---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import InquiryForm from '../components/InquiryForm.astro';
---
<BaseLayout title="Careers" description="Share interest in future commercial cleaning employment opportunities with Cleanital."><PageHero eyebrow="Employment interest" title="Careers at Cleanital" summary="Share your interest in future commercial cleaning work. Submission does not promise employment, an interview, compensation, schedule, start date, or portal access." showCta={false}/><section class="section"><div class="container grid-2"><div class="prose"><h2>What to include</h2><p>Describe relevant experience, availability, transportation or travel considerations, and the type of commercial work that interests you. Do not submit government identification, health records, banking information, background-check documents, or access credentials.</p></div><InquiryForm kind="career"/></div></section></BaseLayout>
