---
import BaseLayout from '../layouts/BaseLayout.astro';import PageHero from '../components/PageHero.astro';import InquiryForm from '../components/InquiryForm.astro';
---
<BaseLayout title="Contractor Opportunities" description="Share interest in future commercial cleaning contractor opportunities with Cleanital."><PageHero eyebrow="Independent contractor interest" title="Contractor opportunities" summary="Share relevant commercial cleaning capability and availability. Submission does not promise a contract award, work volume, rate, schedule, start date, or portal access." showCta={false}/><section class="section"><div class="container grid-2"><div class="prose"><h2>Initial interest only</h2><p>Describe the services, experience, operating area at the state level, availability, and commercial capabilities you want Cleanital to consider. Formal qualification and contracting occur through a separate governed process.</p></div><InquiryForm kind="contractor"/></div></section></BaseLayout>
