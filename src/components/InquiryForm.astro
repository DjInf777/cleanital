---
interface Props { kind: 'assessment'|'contact'|'career'|'contractor'; }
const { kind } = Astro.props;
const config = {
 assessment:{heading:'Tell us about the commercial facility', action:'/api/forms/assessment', submit:'Submit Assessment Request'},
 contact:{heading:'Send a general inquiry', action:'/api/forms/contact', submit:'Submit General Inquiry'},
 career:{heading:'Share your career interest', action:'/api/forms/career', submit:'Submit Career Interest'},
 contractor:{heading:'Share your contractor interest', action:'/api/forms/contractor', submit:'Submit Contractor Interest'}
}[kind];
const isAssessment = kind==='assessment';
const isOpportunity = kind==='career'||kind==='contractor';
---
<section class="form-panel" aria-labelledby={`${kind}-form-heading`}>
  <h2 id={`${kind}-form-heading`}>{config.heading}</h2>
  <p class="small">Fields marked <span aria-hidden="true">*</span><span class="sr-only">required</span> are required. Do not submit passwords, payment data, access codes, health information, government identifiers, or unrelated confidential records.</p>
  <form class="governed-form" method="post" action={config.action} data-form-kind={kind}>
    <input type="hidden" name="startedAt" value={Date.now()} />
    <div class="trap" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <div class="field-grid">
      <label>Contact name <span aria-hidden="true">*</span><input name="contactName" autocomplete="name" required maxlength="120" /></label>
      <label>{isAssessment ? 'Organization name' : 'Organization name (optional)'} {isAssessment && <span aria-hidden="true">*</span>}<input name="organizationName" autocomplete="organization" required={isAssessment} maxlength="160" /></label>
      <label>Email address <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
      <label>Phone number <span aria-hidden="true">*</span><input name="phone" type="tel" autocomplete="tel" required maxlength="40" /></label>
      <label>State <span aria-hidden="true">*</span><select name="state" required><option value="">Select</option><option>North Carolina</option><option>South Carolina</option><option>Other</option></select></label>
      {isAssessment && <label>Facility or organization type <span aria-hidden="true">*</span><select name="facilityType" required><option value="">Select</option><option>Daycare or early education</option><option>Retail</option><option>Office or professional workplace</option><option>Commercial property</option><option>Construction or post-construction project</option><option>Other commercial facility</option></select></label>}
      {isAssessment && <label>Service needed <span aria-hidden="true">*</span><select name="serviceNeeded" required><option value="">Select</option><option>Recurring commercial janitorial service</option><option>Day porter service</option><option>Office cleaning</option><option>Retail cleaning</option><option>Commercial floor care</option><option>Strip and wax</option><option>Scrub and recoat</option><option>Post-construction cleaning</option><option>Project cleaning</option><option>Not sure yet</option></select></label>}
      {isAssessment && <label>Desired frequency <select name="desiredFrequency"><option value="">Not sure / discuss</option><option>One-time project</option><option>Multiple times per week</option><option>Weekly</option><option>Other recurring schedule</option></select></label>}
    </div>
    <label>{isOpportunity ? 'Experience, availability, and interest' : isAssessment ? 'Brief description of the facility and need' : 'How can we help?'} <span aria-hidden="true">*</span><textarea name="message" required minlength="20" maxlength="3000" rows="7"></textarea></label>
    <label class="checkbox"><input type="checkbox" name="consent" value="yes" required /><span>I consent to Cleanital contacting me about this request. I understand that submission does not confirm service, employment, contract work, pricing, scheduling, or acceptance.</span></label>
    <button class="button" type="submit">{config.submit}</button>
    <div class="form-status" role="status" aria-live="polite"></div>
  </form>
</section>
