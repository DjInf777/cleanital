---
import { primaryNav } from '../data/site';
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand" href="/" aria-label="Cleanital home">
      <span class="brand-mark" aria-hidden="true">C</span>
      <span>Cleanital</span>
    </a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav">Menu</button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      {primaryNav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button button-small" href="/request-an-assessment/">Request an Assessment</a>
    </nav>
  </div>
</header>
