---
interface Props { eyebrow?: string; title: string; summary: string; showCta?: boolean; }
const { eyebrow, title, summary, showCta = true } = Astro.props;
---
<section class="page-hero">
  <div class="container narrow">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="lede">{summary}</p>
    {showCta && <div class="hero-actions"><a class="button" href="/request-an-assessment/">Request an Assessment</a><a class="text-link" href="/how-we-work/">Learn how we work <span aria-hidden="true">→</span></a></div>}
  </div>
</section>
